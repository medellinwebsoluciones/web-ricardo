# ------------------------------------------------------------------
# Postgres (Compose en el VPS). La app overridea DATABASE_URL → servicio `db`.
# ------------------------------------------------------------------
POSTGRES_USER="ricardo"
POSTGRES_PASSWORD="cambia-password-db-fuerte"
POSTGRES_DB="webricardo"
# Solo útil fuera de Compose (dev local). En el servidor lo pisa docker-compose.
DATABASE_URL="postgresql://ricardo:cambia-password-db-fuerte@localhost:5432/webricardo?schema=public"

# ------------------------------------------------------------------
# OpenAI (chat + embeddings). Sin clave: arranca igual; RAG sin corpus.
# ------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ------------------------------------------------------------------
# NextAuth (admin)
# ------------------------------------------------------------------
# En producción: https://tudominio.com
NEXTAUTH_URL="https://tudominio.com"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
ADMIN_EMAIL="ricki5789@gmail.com"
# Preferir password en claro: el seed lo hashea (evita pelearse con $ en Compose).
ADMIN_PASSWORD="cambia-password-admin"
ADMIN_PASSWORD_HASH=""

# ------------------------------------------------------------------
# Google Calendar + Meet (OAuth) — opcional
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tudominio.com/api/google/callback"
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# ------------------------------------------------------------------
# SMTP — opcional
# ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ricardo Zuluaga <ricki5789@gmail.com>"
CONTACT_EMAIL="ricki5789@gmail.com"

# ------------------------------------------------------------------
# Sitio
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://tudominio.com"
BOOKING_TIMEZONE="America/Bogota"

# Puerto del host al que Compose publica la app (solo 127.0.0.1).
# Cámbialo si el 3000 ya está ocupado por otro sitio del servidor.
APP_PORT="3000"

# ------------------------------------------------------------------
# Biblioteca de documentos del panel (CV, propuestas, certificados)
# En Compose el volumen `app_uploads` se monta en /app/storage/uploads.
# En dev local, si no se define, usa ./storage/uploads.
# ------------------------------------------------------------------
UPLOAD_DIR="/app/storage/uploads"
MAX_UPLOAD_MB="15"

# ------------------------------------------------------------------
# Compose: en el primer arranque usa RUN_SEED=1 en la línea de comando
# ------------------------------------------------------------------
RUN_SEED="0"
