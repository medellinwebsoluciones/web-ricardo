# ------------------------------------------------------------------
# Postgres (Compose en el VPS). La app overridea DATABASE_URL → servicio `db`.
# ------------------------------------------------------------------
POSTGRES_USER="ricardo"
POSTGRES_PASSWORD="cambia-password-db-fuerte"
POSTGRES_DB="webricardo"
# Solo útil fuera de Compose (dev local). En el servidor lo pisa docker-compose.
DATABASE_URL="postgresql://ricardo:cambia-password-db-fuerte@localhost:5432/webricardo?schema=public"

# ------------------------------------------------------------------
# OpenAI (chat + embeddings). Sin clave: arranca igual; RAG sin corpus.
# ------------------------------------------------------------------
OPENAI_API_KEY=""
# El chat publico es el escaparate comercial: modelo grande.
OPENAI_CHAT_MODEL="gpt-4o"
# Analista de turno y juez de evaluaciones: alto volumen, tarea acotada.
OPENAI_ANALYST_MODEL="gpt-4o-mini"
OPENAI_JUDGE_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ------------------------------------------------------------------
# LLM por rol (opcional). Todos los proveedores interesantes son
# OpenAI-compat, asi que cambiar de proveedor es cambiar baseURL + key +
# modelo. Sin definir nada, los cuatro roles van a OpenAI.
#
# Roles: CHAT | ANALYST | JUDGE | EMBEDDINGS
# Ejemplo para mover solo el juez a un proveedor gratis:
#   LLM_JUDGE_PROVIDER="groq"
#   LLM_JUDGE_BASE_URL="https://api.groq.com/openai/v1"
#   LLM_JUDGE_API_KEY="gsk_..."
#   LLM_JUDGE_MODEL="llama-3.3-70b-versatile"
#
# EMBEDDINGS se queda en OpenAI a proposito: el corpus vive en una columna
# vector(1536) y otro proveedor cambia la dimension.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# NextAuth (admin)
# ------------------------------------------------------------------
# En producción: https://tudominio.com
NEXTAUTH_URL="https://tudominio.com"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
ADMIN_EMAIL="admin@tudominio.com"
# Seed exige ADMIN_PASSWORD o ADMIN_PASSWORD_HASH ($2…). Sin uno de los dos, falla.
# En producción el login ignora ADMIN_PASSWORD en claro: usa hash o el AdminUser de BD.
ADMIN_PASSWORD="cambia-password-admin"
ADMIN_PASSWORD_HASH=""

# Token para la extensión Chrome (header x-ingest-token). Genera uno largo.
# JOB_INGEST_TOKEN="rz-ingest-cambia-esto"
# Orígenes CORS permitidos para ingest (coma-separados). Sin definir = *.
# JOB_INGEST_ORIGINS="chrome-extension://TU_EXTENSION_ID,https://tudominio.com"

# ------------------------------------------------------------------
# Google Calendar + Meet (OAuth) — opcional
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://tudominio.com/api/google/callback"
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
# Setup OAuth: sesión admin O este token en ?key= / header x-google-setup-token.
# No uses NEXTAUTH_SECRET aquí.
# GOOGLE_SETUP_TOKEN="cambia-por-token-largo-aleatorio"

# ------------------------------------------------------------------
# SMTP — opcional
# ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Ricardo Zuluaga <ricki5789@gmail.com>"
CONTACT_EMAIL="ricki5789@gmail.com"

# ------------------------------------------------------------------
# Sitio
# ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://tudominio.com"
BOOKING_TIMEZONE="America/Bogota"

# Puerto del host al que Compose publica la app (solo 127.0.0.1).
# Cámbialo si el 3000 ya está ocupado por otro sitio del servidor.
APP_PORT="3000"

# ------------------------------------------------------------------
# Biblioteca de documentos del panel (CV, propuestas, certificados)
# En Compose el volumen `app_uploads` se monta en /app/storage/uploads.
# En dev local, si no se define, usa ./storage/uploads.
# ------------------------------------------------------------------
UPLOAD_DIR="/app/storage/uploads"
MAX_UPLOAD_MB="15"

# ------------------------------------------------------------------
# Compose: en el primer arranque usa RUN_SEED=1 en la línea de comando
# ------------------------------------------------------------------
RUN_SEED="0"
