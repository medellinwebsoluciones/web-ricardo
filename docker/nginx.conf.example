# Reverse proxy con Nginx + TLS para el VPS.
#
# Instalación (tras apuntar el registro A del dominio a la IP del VPS):
#   cp docker/nginx.conf.example /etc/nginx/sites-available/TU_DOMINIO.conf
#   ln -sf /etc/nginx/sites-available/TU_DOMINIO.conf /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d TU_DOMINIO --non-interactive --agree-tos -m TU_EMAIL --redirect
#
# El puerto del upstream debe coincidir con APP_PORT del .env.

upstream web_ricardo {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name TU_DOMINIO;

    # Subida de documentos desde la consola (ver MAX_UPLOAD_MB).
    client_max_body_size 20M;

    # Necesario para el streaming del chat del agente (SSE-like).
    proxy_buffering off;

    location / {
        proxy_pass http://web_ricardo;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
