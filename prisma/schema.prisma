generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// RAG / Knowledge base (portado del pipeline agent_knowledge)
// ---------------------------------------------------------------------------
model KnowledgeCollection {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  isPublic  Boolean          @default(true)
  createdAt DateTime         @default(now())
  entries   KnowledgeEntry[]
  chunks    KnowledgeChunk[]
}

model KnowledgeEntry {
  id           String              @id @default(cuid())
  collectionId String
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  title        String
  sourceType   String              @default("manual") // manual | site | doc | faq
  sourceRef    String? // path / url
  lang         String              @default("es")
  trustTier    String              @default("canonical") // canonical | operational | draft
  content      String
  createdAt    DateTime            @default(now())
  chunks       KnowledgeChunk[]
}

model KnowledgeChunk {
  id           String                       @id @default(cuid())
  entryId      String
  entry        KnowledgeEntry               @relation(fields: [entryId], references: [id], onDelete: Cascade)
  collectionId String
  collection   KnowledgeCollection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  idx          Int                          @default(0)
  content      String
  tokens       Int?
  // pgvector column (managed via raw SQL, dimension 1536 = text-embedding-3-small)
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                     @default(now())

  @@index([collectionId])
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------
model ChatSession {
  id         String        @id @default(uuid())
  locale     String        @default("es")
  visitorId  String?
  channel    String        @default("site") // site | admin (playground / simulador)
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  messages   ChatMessage[]

  // Estado conversacional deducido por el analista de turno
  audience String? // reclutador | hiring_manager | cto | ceo | agencia | desconocido
  stage    String? // apertura | descubrimiento | diagnostico | propuesta | cierre
  leadId   String? // lead creado/actualizado desde el chat

  analyses ChatTurnAnalysis[]

  @@index([channel])
  @@index([audience])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // user | assistant | system
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

/// Lectura del interlocutor turno a turno: alimenta la seleccion de capas de
/// persona y deja el trazo de retrieval para diagnosticar en el panel.
model ChatTurnAnalysis {
  id         String      @id @default(cuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn       Int         @default(0)
  message    String
  audience   String      @default("desconocido")
  intent     String      @default("otro")
  stage      String      @default("apertura")
  sentiment  String      @default("neutral")
  urgency    String      @default("baja")
  objections String[]    @default([])
  extracted  Json? // { name, company, role, need, budgetSignal, timeline }
  tactic     String?
  ragTrace   Json? // [{ id, title, similarity }]
  createdAt  DateTime    @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Entrenador del agente: persona versionada, evaluaciones, simulaciones
// ---------------------------------------------------------------------------

/// Version editable del prompt del agente. El nucleo (identidad + grounding)
/// vive en codigo; aqui solo las capas que se pueden tunear sin redeploy.
model AgentPromptVersion {
  id              String   @id @default(cuid())
  version         Int      @unique
  name            String
  notes           String?
  psychologyLayer String
  audienceLayers  Json // { reclutador: "...", cto: "...", ... }
  stageLayers     Json // { apertura: "...", descubrimiento: "...", ... }
  model           String   @default("gpt-4o")
  temperature     Float    @default(0.6)
  maxTokens       Int      @default(700)
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs EvalRun[]

  @@index([isActive])
}

/// Agrupacion de casos de evaluacion (normalmente un panel de auditor).
model EvalSuite {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  cases       EvalCase[]
  runs        EvalRun[]
}

model EvalCase {
  id         String    @id @default(cuid())
  suiteId    String
  suite      EvalSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  externalId String? // id del banco en codigo, para re-sincronizar
  question   String
  locale     String    @default("es")
  audience   String    @default("reclutador")
  difficulty String    @default("media") // baja | media | alta
  mustCover  String[]  @default([])
  redFlags   String[]  @default([])
  createdAt  DateTime  @default(now())

  results EvalResult[]

  @@unique([suiteId, externalId])
  @@index([suiteId])
}

model EvalRun {
  id              String              @id @default(cuid())
  suiteId         String
  suite           EvalSuite           @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  promptVersionId String?
  promptVersion   AgentPromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  label           String?
  model           String
  status          String              @default("running") // running | done | error
  totalCases      Int                 @default(0)
  completedCases  Int                 @default(0)
  avgScore        Float?
  dimensionAvgs   Json? // { grounding: 82, naturalidad: 71, ... }
  corpusChunks    Int                 @default(0)
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?

  results EvalResult[]

  @@index([suiteId])
  @@index([startedAt])
}

model EvalResult {
  id             String   @id @default(cuid())
  runId          String
  run            EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId         String
  case           EvalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  answer         String
  scores         Json // { grounding, especificidad, naturalidad, empatia, rol, comercial, concision }
  score          Float
  diagnosis      String?
  improved       String? // respuesta mejorada sugerida por el juez
  sources        Json? // fuentes RAG recuperadas
  bestSimilarity Float    @default(0)
  createdAt      DateTime @default(now())

  @@index([runId])
  @@index([caseId])
}

/// Role-play adversario: un LLM interpreta a un personaje dificil y conversa
/// con el agente para ver si consigue cerrar la llamada.
model SimulationRun {
  id          String    @id @default(cuid())
  personaSlug String
  personaName String
  locale      String    @default("es")
  maxTurns    Int       @default(8)
  status      String    @default("running") // running | done | error
  booked      Boolean? // veredicto: habria agendado la llamada
  verdict     String?
  score       Float?
  failures    String[]  @default([])
  model       String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  turns SimulationTurn[]

  @@index([personaSlug])
  @@index([startedAt])
}

model SimulationTurn {
  id        String        @id @default(cuid())
  runId     String
  run       SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  idx       Int           @default(0)
  role      String // prospect | agent
  content   String
  createdAt DateTime      @default(now())

  @@index([runId])
}

/// Pregunta que el corpus no supo responder. Se llena desde el playground, las
/// notas bajas de las evals y la mineria de chats reales del sitio.
model KnowledgeGap {
  id             String   @id @default(cuid())
  question       String
  normalized     String   @unique // para deduplicar por frecuencia
  source         String   @default("playground") // playground | eval | chat
  audience       String?
  hits           Int      @default(1)
  bestSimilarity Float    @default(0)
  status         String   @default("abierto") // abierto | resuelto | descartado
  answer         String?
  entryId        String? // entrada de corpus creada al resolverlo
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([hits])
}

/// Ejemplo aprobado para el dataset de fine-tuning (estilo, no hechos).
model TrainingExample {
  id         String    @id @default(cuid())
  question   String
  answer     String
  audience   String    @default("reclutador")
  locale     String    @default("es")
  source     String    @default("correccion") // correccion | eval | simulacion
  approved   Boolean   @default(true)
  exportedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([approved])
  @@index([source])
}

// ---------------------------------------------------------------------------
// Consumo IA (tokens/coste) - portado de NovaApiUsage
// ---------------------------------------------------------------------------
model ApiUsage {
  id               String   @id @default(cuid())
  channel          String // chat | embeddings | analyst | judge | simulation
  model            String
  // Proveedor y tier quedan registrados desde ya: cuando el chat pase por una
  // cascada de proveedores gratis, el panel de consumo ya sabe desglosarlos.
  provider         String   @default("openai")
  tier             String   @default("paid") // free | paid
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([channel])
  @@index([provider])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Citas + Google Meet
// ---------------------------------------------------------------------------
model Appointment {
  id            String   @id @default(cuid())
  name          String
  email         String
  topic         String?
  scheduledAt   DateTime
  durationMin   Int      @default(15)
  timezone      String   @default("America/Bogota")
  locale        String   @default("es")
  status        String   @default("confirmed") // pending (sin Meet, por confirmar a mano) | confirmed | cancelled | completed
  googleEventId String?
  meetLink      String?
  createdAt     DateTime @default(now())

  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// Leads / contacto
// ---------------------------------------------------------------------------
model Lead {
  id      String  @id @default(cuid())
  name    String
  email   String
  message String?
  source  String  @default("contact") // contact | chat | booking
  locale  String  @default("es")

  // Pipeline comercial
  company         String?
  role            String?
  phone           String?
  status          String    @default("nuevo") // nuevo | contactado | calificado | propuesta | ganado | perdido
  temperature     String    @default("media") // alta | media | baja
  value           Float?
  nextAction      String?
  nextActionAt    DateTime?
  lastContactedAt DateTime?
  aiSummary       String?
  tags            String[]  @default([])

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  notes     LeadNote[]

  @@index([source])
  @@index([createdAt])
  @@index([status])
  @@index([nextActionAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

// ---------------------------------------------------------------------------
// Analytics first-party
// ---------------------------------------------------------------------------
model VisitSession {
  id          String   @id @default(cuid())
  visitorId   String   @unique
  landingPath String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  pageViews   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([firstSeenAt])
}

model PageHit {
  id        String   @id @default(cuid())
  visitorId String
  path      String
  locale    String?
  referrer  String?
  dwellMs   Int?
  scrollPct Int?
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Biblioteca de documentos (archivos en volumen, metadatos aqui)
// ---------------------------------------------------------------------------
model Document {
  id               String   @id @default(cuid())
  title            String
  kind             String   @default("otro") // cv | propuesta | certificado | caso | otro
  lang             String   @default("es")
  filename         String // nombre original
  storedName       String   @unique // nombre aleatorio en disco
  mimeType         String
  sizeBytes        Int
  version          Int      @default(1)
  tags             String[] @default([])
  // Texto extraido (PDF/DOCX/MD/TXT) para poder enviarlo al RAG
  extractedText    String?
  knowledgeEntryId String?
  createdAt        DateTime @default(now())

  @@index([kind])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Oportunidades (empleo fijo remoto / consultoria) + material generado
// ---------------------------------------------------------------------------
model Opportunity {
  id             String    @id @default(cuid())
  company        String
  role           String
  type           String    @default("fijo-remoto") // fijo-remoto | consultoria | freelance
  location       String?
  remote         Boolean   @default(true)
  url            String?
  salaryRange    String?
  stage          String    @default("guardada") // guardada | aplicada | entrevista | oferta | cerrada
  priority       String    @default("media") // alta | media | baja
  matchScore     Int?
  matchGaps      String?
  jobDescription String?
  nextAction     String?
  nextActionAt   DateTime?
  notes          String?
  /// Origen: manual | linkedin | remoteok | remotive | arbeitnow | email
  source         String?
  /// Id estable del origen (para no duplicar al re-escanear el radar).
  externalId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  events OpportunityEvent[]
  assets GeneratedAsset[]

  @@index([stage])
  @@index([type])
  @@index([nextActionAt])
  @@index([url])
  @@unique([source, externalId])
}

model OpportunityEvent {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String // creada | etapa | nota | envio | entrevista
  note          String?
  at            DateTime    @default(now())

  @@index([opportunityId])
}

model GeneratedAsset {
  id            String       @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  kind          String // cv | carta | propuesta
  locale        String       @default("es")
  title         String
  content       String
  model         String?
  createdAt     DateTime     @default(now())

  @@index([opportunityId])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
